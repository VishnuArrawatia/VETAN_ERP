# GEMINI_API_KEY: Required for Gemini AI API calls (local Express server only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Required for Vercel + Supabase (Vercel Project → Settings → Environment Variables)
# URL is already hardcoded in src/lib/supabase.ts for this project.
# Only the Publishable key is needed here / on Vercel:
VITE_SUPABASE_ANON_KEY="sb_publishable_..."
