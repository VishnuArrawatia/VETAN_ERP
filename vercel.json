{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": ["server/**", "src/types.ts"]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/((?!data/|api/).*)", "destination": "/index.html" }
  ]
}
